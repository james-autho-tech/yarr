# =====================================================================
# yArr — behavioural config. Edit this in place at
# /addon_configs/yarr/apps.yaml (persists across add-on updates).
#
# Do NOT put API keys/credentials here — AppDaemon's own apps.yaml
# loader has no !secret support (a bad !secret tag here silently kills
# the whole app — see the run script's self-heal). Use this add-on's
# Configuration tab instead: it's the only place a Radarr/Sonarr/
# Jellyfin/TMDB/SABnzbd key is actually masked and stored safely.
# =====================================================================

yarr:
  module: yarr
  class: Yarr

  # --- Movies (Radarr) ---

  # Genres to match for regular ("good film") auto-adds. Case
  # insensitive, matched against TMDB's own genre vocabulary (e.g.
  # action, comedy, drama, horror, science fiction, thriller). Leave
  # empty ([]) to disable the genre filter entirely (rating floor
  # still applies). Ignored if learn_genres_from_library is true and
  # your library has yielded a learned list — see below.
  genres:
    - action
    - comedy
    - science fiction

  min_rating: 7.0
  discovery_interval_hours: 24
  max_suggestions_per_run: 3

  radarr_root_folder: /movies
  radarr_quality_profile_name: HD-1080p
  radarr_minimum_availability: announced

  # The "randomly treat me to a film" loop. surprise_genres defaults to
  # the same list as `genres` above if left unset — set it separately
  # only if you want surprises to draw from a different pool.
  surprise_enabled: true
  # surprise_genres:
  #   - thriller
  surprise_min_days: 5
  surprise_max_days: 10
  surprise_tag: yarr-surprise
  # When true (default), a surprise pick waits for Accept/Deny in the
  # web UI before ever touching Radarr — nothing is added automatically
  # until you approve it. Set to false to go back to auto-adding
  # surprises outright. Shared with TV below — one approval model for
  # both, not separately configurable per medium.
  surprise_requires_approval: true

  # --- TV (Sonarr) — entirely opt-in: only runs once sonarr_url and
  # sonarr_api_key are set in the Configuration tab. Leave this whole
  # section as-is for a movies-only install. ---

  tv_genres:
    - action
    - comedy
    - science fiction
  tv_min_rating: 7.0
  tv_discovery_interval_hours: 24
  tv_max_suggestions_per_run: 3

  sonarr_root_folder: /tv
  sonarr_quality_profile_name: HD-1080p
  # Only sent to Sonarr if set — Sonarr v4 dropped Language Profiles,
  # so leave this unset unless you're on Sonarr v3 and it complains.
  # sonarr_language_profile_id: 1

  tv_surprise_enabled: true
  # tv_surprise_genres:
  #   - drama
  tv_surprise_min_days: 5
  tv_surprise_max_days: 10
  tv_surprise_tag: yarr-surprise
  # A surprise show is only deleted once its LAST episode crosses
  # completion_threshold_pct — not each episode as you go.

  # --- Shared ---

  # A surprise film/show is only ever deleted once Jellyfin reports it
  # played to at least this percentage, and only after the grace
  # period below — flip input_boolean.yarr_keep_surprise (or
  # yarr_keep_surprise_tv for shows) on before the grace period
  # elapses to keep it instead.
  completion_threshold_pct: 90
  delete_grace_period_hours: 24

  # Which Jellyfin user's watch history counts for "already watched"
  # exclusion and for learn_genres_from_library below. Leave unset on
  # a single-user Jellyfin instance — yArr just uses whichever account
  # its API key's own user lookup returns first.
  # jellyfin_username: james
  watched_resync_hours: 24

  # When true, ignores genres/tv_genres above and instead learns a
  # weighted genre profile from what's already in your Jellyfin
  # library (watched/favourited items, weighted by play count) —
  # refreshed on the same watched_resync_hours cadence. Falls back to
  # the lists above if your library hasn't yielded anything yet (e.g.
  # a brand new Jellyfin instance).
  learn_genres_from_library: false
  taste_top_n_genres: 5

  # Hard veto — a title carrying any of these is never suggested or
  # surprised, regardless of genres/tv_genres above or a learned
  # profile. Applies to both movies and TV.
  excluded_genres:
    - horror

  # Denying a surprise proposal in the web UI tallies each of its
  # genres — once a genre has been denied this many times, it's added
  # to the exclusion above automatically for future picks (movies and
  # TV share the same tally). Only denials count; accepts are tracked
  # for visibility but don't currently change what gets picked.
  surprise_feedback_deny_threshold: 2

  # TMDB returns 20 results per page — page 1 alone gets exhausted fast
  # once genre/rating/exclusion/already-suggested filters are applied,
  # which is the usual cause of "no surprise candidate matched your
  # filters this time" showing up often. Raise if that keeps happening;
  # each extra page costs a few more TMDB API calls per discovery tick.
  tmdb_pages: 3

  # If true, discovery/surprise picks are computed and logged but never
  # actually added to Radarr/Sonarr — useful for checking your genre/
  # rating settings are producing sensible picks before trusting it
  # for real.
  dry_run: false
