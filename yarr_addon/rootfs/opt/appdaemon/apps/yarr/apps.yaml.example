# =====================================================================
# yArr — behavioural config. Edit this in place at
# /addon_configs/yarr/apps.yaml (persists across add-on updates).
#
# Do NOT put API keys/credentials here — AppDaemon's own apps.yaml
# loader has no !secret support (a bad !secret tag here silently kills
# the whole app — see the run script's self-heal). Use this add-on's
# Configuration tab instead: it's the only place a Radarr/Sonarr/
# Jellyfin/TMDB/SABnzbd key is actually masked and stored safely.
#
# dry_run, surprise_enabled, tv_surprise_enabled,
# surprise_requires_approval, learn_genres_from_library, the genre lists
# (genres/tv_genres/excluded_genres/surprise_genres/tv_surprise_genres),
# and min_rating/max_suggestions_per_run (+ tv_ equivalents) are all now
# live-editable in the web UI's Settings tab instead of apps.yaml-only
# settings — the values below only ever seed each one's state the FIRST
# time the add-on creates it (so upgrading doesn't silently change your
# current behaviour). Once created, editing the value here does
# nothing — change it in the Settings tab instead.
# =====================================================================

yarr:
  module: yarr
  class: Yarr

  # --- Movies (Radarr) ---

  # Genres to match for regular ("good film") auto-adds. Case
  # insensitive, matched against TMDB's own genre vocabulary (e.g.
  # action, comedy, drama, horror, science fiction, thriller). Leave
  # empty ([]) to disable the genre filter entirely (rating floor
  # still applies). Ignored if learn_genres_from_library is true and
  # your library has yielded a learned list — see below.
  genres:
    - action
    - comedy
    - science fiction

  min_rating: 7.0
  discovery_interval_hours: 24
  max_suggestions_per_run: 3

  radarr_root_folder: /movies
  radarr_quality_profile_name: HD-1080p
  radarr_minimum_availability: announced

  # The "randomly treat me to a film" loop. surprise_genres defaults to
  # the same list as `genres` above if left unset — set it separately
  # only if you want surprises to draw from a different pool.
  surprise_enabled: true
  # surprise_genres:
  #   - thriller
  surprise_min_days: 5
  surprise_max_days: 10
  surprise_tag: yarr-surprise
  # When true (default), a surprise pick waits for Accept/Deny in the
  # web UI before ever touching Radarr — nothing is added automatically
  # until you approve it. Set to false to go back to auto-adding
  # surprises outright. Shared with TV below — one approval model for
  # both, not separately configurable per medium.
  surprise_requires_approval: true

  # --- TV (Sonarr) — entirely opt-in: only runs once sonarr_url and
  # sonarr_api_key are set in the Configuration tab. Leave this whole
  # section as-is for a movies-only install. ---

  tv_genres:
    - action
    - comedy
    - science fiction
  tv_min_rating: 7.0
  tv_discovery_interval_hours: 24
  tv_max_suggestions_per_run: 3

  sonarr_root_folder: /tv
  sonarr_quality_profile_name: HD-1080p
  # Only sent to Sonarr if set — Sonarr v4 dropped Language Profiles,
  # so leave this unset unless you're on Sonarr v3 and it complains.
  # sonarr_language_profile_id: 1

  tv_surprise_enabled: true
  # tv_surprise_genres:
  #   - drama
  tv_surprise_min_days: 5
  tv_surprise_max_days: 10
  tv_surprise_tag: yarr-surprise
  # A surprise show is only deleted once its LAST episode crosses
  # completion_threshold_pct — not each episode as you go.

  # --- Shared ---

  # A surprise film/show is only ever deleted once Jellyfin reports it
  # played to at least this percentage, and only after the grace
  # period below — flip input_boolean.yarr_keep_surprise (or
  # yarr_keep_surprise_tv for shows) on before the grace period
  # elapses to keep it instead.
  completion_threshold_pct: 90
  delete_grace_period_hours: 24

  # Which Jellyfin user's watch history counts for "already watched"
  # exclusion and for learn_genres_from_library below. Leave unset on
  # a single-user Jellyfin instance — yArr just uses whichever account
  # its API key's own user lookup returns first.
  # jellyfin_username: james
  watched_resync_hours: 24

  # When true, ignores genres/tv_genres above and instead learns a
  # weighted genre profile blending two signals: what Jellyfin says
  # you've actually watched (watched/favourited items, weighted by
  # play count) and what's sitting in your full Radarr/Sonarr library
  # at all (the Library tab's data — a weaker signal on its own, since
  # owning something isn't the same as liking it, but still counted).
  # A title that's both owned and watched ends up weighted higher than
  # one merely owned. Refreshed on the same watched_resync_hours
  # cadence. Falls back to the lists above if neither has yielded
  # anything yet (e.g. a brand new Jellyfin instance and an empty
  # library).
  learn_genres_from_library: false
  taste_top_n_genres: 5

  # Hard veto — a title carrying any of these is never suggested or
  # surprised, regardless of genres/tv_genres above or a learned
  # profile. Applies to both movies and TV. Denying a surprise proposal
  # in the web UI never touches this list automatically — it blocks
  # that one exact title instead (see the Blocked tab); add a genre
  # here yourself, or in the Settings tab, if you want it gone entirely.
  excluded_genres:
    - horror

  # TMDB returns 20 results per page — page 1 alone gets exhausted fast
  # once genre/rating/exclusion/already-suggested filters are applied,
  # which is the usual cause of "no surprise candidate matched your
  # filters this time" showing up often. Raise if that keeps happening;
  # each extra page costs a few more TMDB API calls per discovery tick.
  tmdb_pages: 3

  # --- Media cleanup scan (optional) — needs HA's own /media share
  # pointed at your NAS first (Settings → System → Storage → Add
  # Network Storage, Usage: Media) and the writable `media` map entry
  # in config.yaml (already there — write access is needed for the
  # Cleanup tab's delete buttons). Leave media_scan_paths empty to
  # disable this entirely — it's off by default. Finds duplicate files
  # (by exact size) and leftover SABnzbd unpack junk in the same
  # filesystem pass; see DOCS.md for what gets deleted automatically
  # vs. what needs a button press.
  media_scan_paths: []
  #   - /media/movies
  #   - /media/tv
  media_scan_min_size_mb: 50
  media_scan_interval_hours: 24

  # A leftover _UNPACK_/_FAILED_ folder or stray archive piece is only
  # ever touched once it hasn't been modified for this long — without
  # this, a folder SABnzbd is actively extracting into right now (which
  # looks identical to an abandoned one at a glance) could get deleted
  # mid-extraction. Empty (0-byte) junk older than this is deleted
  # automatically on every scan; anything with real data in it still
  # needs a button press in the Cleanup tab.
  junk_min_age_hours: 1

  # --- Library tab (search-and-request hub + full-library manager) ---
  # Search/browse/add are always available; refreshed automatically
  # this often (cheap — a Radarr/Sonarr GET each, no NAS walk) or
  # on-demand via the tab's Refresh Library button.
  library_refresh_interval_hours: 1

  # Deleting from the FULL library (not just a yArr-added surprise) is
  # off by default — it can remove a movie/show you've had for years,
  # never touched by yArr at all, a much bigger blast radius than
  # anything else yArr deletes. Set to true to enable the Delete
  # buttons in the Library tab (still needs the web UI's own confirm
  # on top of this).
  allow_library_delete: false

  # --- Free Up Space (optional) — opt-in via media_scan_paths above
  # being non-empty, since checking real disk usage needs that same NAS
  # mount. When usage crosses low_space_threshold_pct, the Library tab
  # lists your least-recently-active titles for review (never watched,
  # or watched longest ago) — a recommendation list only, deleting one
  # still uses the same Delete button/allow_library_delete gate as the
  # rest of the Library tab. See DOCS.md.
  low_space_threshold_pct: 90
  cycle_candidates_count: 20
  space_check_interval_hours: 6

  # If true, discovery/surprise picks are computed and logged but never
  # actually added to Radarr/Sonarr — useful for checking your genre/
  # rating settings are producing sensible picks before trusting it
  # for real.
  dry_run: false
