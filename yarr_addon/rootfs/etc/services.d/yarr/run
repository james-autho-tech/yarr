#!/usr/bin/with-contenv bashio
# ==============================================================================
# Starts yArr's bundled AppDaemon instance.
# ==============================================================================

CONFIG_DIR=/config

# config.yaml's version is the single source of truth — yarr.py reads
# it via this env var instead of keeping its own separate constant.
export YARR_VERSION="$(bashio::addon.version 2>/dev/null)" || true

mkdir -p "${CONFIG_DIR}/apps/yarr"

YARR_YAML="${CONFIG_DIR}/apps/yarr/apps.yaml"

if [ ! -f "$YARR_YAML" ]; then
    bashio::log.info "No apps.yaml in addon_config yet — copying the template."
    bashio::log.warning "Edit ${YARR_YAML} before trusting anything it adds to Radarr."
    cp /opt/appdaemon/apps/yarr/apps.yaml.example "$YARR_YAML"
else
    # AppDaemon silently fails to load the whole app if this file
    # doesn't parse (e.g. an unsupported !secret tag — there is no
    # secrets.yaml support in AppDaemon's app-config loader), with
    # nothing but "Failed to read file" in the log to go on. Validate
    # it ourselves first so a broken file can't sit there forever.
    YAML_ERR="$(python3 -c "
import sys, yaml
try:
    yaml.safe_load(open('$YARR_YAML'))
except Exception as exc:
    print(exc)
    sys.exit(1)
" 2>&1)" || true
    if [ -n "$YAML_ERR" ]; then
        bashio::log.error "apps.yaml failed to parse: ${YAML_ERR}"
        bashio::log.error "Backing it up to apps.yaml.broken and restoring the template so the engine can start — re-apply your settings to the fresh copy."
        cp "$YARR_YAML" "${YARR_YAML}.broken"
        cp /opt/appdaemon/apps/yarr/apps.yaml.example "$YARR_YAML"
    fi
fi

if [ ! -f "${CONFIG_DIR}/secrets.yaml" ]; then
    touch "${CONFIG_DIR}/secrets.yaml"
fi

# yarr.py, core/ and clients/ always come from the image (update by
# installing a new add-on version); apps.yaml and the persisted state/
# token JSON files persist in addon_config.
cp /opt/appdaemon/apps/yarr/yarr.py "${CONFIG_DIR}/apps/yarr/yarr.py"
rm -rf "${CONFIG_DIR}/apps/yarr/core"
cp -r /opt/appdaemon/apps/yarr/core "${CONFIG_DIR}/apps/yarr/core"
rm -rf "${CONFIG_DIR}/apps/yarr/clients"
cp -r /opt/appdaemon/apps/yarr/clients "${CONFIG_DIR}/apps/yarr/clients"

# Helpers (input_boolean/input_button) + the Jellyfin webhook-relay
# automation are created through HA core's own Config REST API
# (/api/config/<domain>/config/<id> — the same endpoint Settings >
# Helpers/Automations uses) rather than by writing a YAML file into
# /config. This needs nothing beyond the Core API access every add-on
# already has (hassio_api/homeassistant_api) — no homeassistant_config
# filesystem mount, and critically no Protection-mode approval, which
# a real install showed can silently stay blocked even with the map
# entry correctly declared. Idempotent (POST upserts by id), so this
# just runs — and re-applies instantly, no HA restart — every boot.
bashio::log.info "Syncing yArr's HA helpers + webhook-relay automation..."
python3 - <<'PYEOF' || true
import json
import os
import urllib.error
import urllib.request

token = os.environ["SUPERVISOR_TOKEN"]
BASE = "http://supervisor/core/api/config"


def put(domain, key, body):
    req = urllib.request.Request(
        f"{BASE}/{domain}/config/{key}", method="POST",
        data=json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=10)
        print(f"Synced {domain}.{key}")
    except (urllib.error.URLError, urllib.error.HTTPError) as exc:
        print(f"Could not sync {domain}.{key}: {exc}")


put("input_boolean", "yarr_enable",
    {"name": "yArr Engine Master Switch", "icon": "mdi:movie-open-play", "initial": True})
put("input_boolean", "yarr_keep_surprise",
    {"name": "yArr: Keep the pending surprise film", "icon": "mdi:heart", "initial": False})
# Separate from yarr_keep_surprise so a pending movie deletion and a
# pending show deletion can't accidentally cross-cancel each other.
put("input_boolean", "yarr_keep_surprise_tv",
    {"name": "yArr: Keep the pending surprise show", "icon": "mdi:heart", "initial": False})
put("input_button", "yarr_surprise_me_now",
    {"name": "yArr: Surprise Me Now", "icon": "mdi:dice-multiple"})
# Only useful once Sonarr is configured — harmless to leave visible either way.
put("input_button", "yarr_surprise_tv_now",
    {"name": "yArr: Surprise Me Now (TV)", "icon": "mdi:dice-multiple-outline"})
put("automation", "yarr_playback_stop_relay", {
    "alias": "yArr Jellyfin playback-stop relay",
    "description": ("Re-fires Jellyfin's Webhook-plugin PlaybackStop payload (Movie or "
                     "Episode) as a plain HA event yarr.py subscribes to via listen_event() "
                     "— see DOCS.md for the Jellyfin-side webhook template this expects."),
    "mode": "queued",
    "triggers": [{"trigger": "webhook", "webhook_id": "yarr_playback_stop",
                  "local_only": True, "allowed_methods": ["POST"]}],
    "actions": [{"event": "yarr_jellyfin_webhook", "event_data": {"payload": "{{ trigger.json }}"}}],
})
PYEOF

# Real credentials from the add-on's Configuration tab — written as a
# small JSON file yarr.py reads at startup, never touching apps.yaml.
# Passed via env vars (not string-interpolated) to dodge quoting issues.
for f in radarr_url radarr_api_key sonarr_url sonarr_api_key \
         jellyfin_url jellyfin_api_key tmdb_api_key \
         sabnzbd_url sabnzbd_api_key; do
    val="$(bashio::config "$f" 2>/dev/null)" || val=""
    if [ "$val" != "null" ] && [ -n "$val" ]; then
        export "YARR_SEC_${f}=${val}"
    fi
done
python3 - "${CONFIG_DIR}" <<'PYEOF' || true
import json
import os
import sys

config_dir = sys.argv[1]
prefix = "YARR_SEC_"
secrets = {k[len(prefix):]: v for k, v in os.environ.items() if k.startswith(prefix)}
path = os.path.join(config_dir, "apps", "yarr", "addon_secrets.json")
with open(path, "w") as f:
    json.dump(secrets, f)
os.chmod(path, 0o600)
PYEOF

# AppDaemon requires latitude/longitude/elevation/time_zone up front —
# fetch them from HA core's own config via the Supervisor API proxy
# rather than hardcoding, with a short retry in case core isn't ready.
if ! python3 - "${CONFIG_DIR}" <<'PYEOF'
import json
import os
import sys
import time
import urllib.error
import urllib.request

config_dir = sys.argv[1]
token = os.environ["SUPERVISOR_TOKEN"]
req = urllib.request.Request(
    "http://supervisor/core/api/config",
    headers={"Authorization": f"Bearer {token}"})

core = None
for attempt in range(12):
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            core = json.load(resp)
        break
    except (urllib.error.URLError, TimeoutError) as exc:
        print(f"Waiting for HA core API ({exc})...", file=sys.stderr)
        time.sleep(5)

if core is None:
    print("Could not reach HA core API after 60s", file=sys.stderr)
    sys.exit(1)

appdaemon_yaml = f"""appdaemon:
  latitude: {core['latitude']}
  longitude: {core['longitude']}
  elevation: {core['elevation']}
  time_zone: {core['time_zone']}
  plugins:
    HASS:
      type: hass
      ha_url: http://supervisor/core
      token: {token}
"""
with open(os.path.join(config_dir, "appdaemon.yaml"), "w") as f:
    f.write(appdaemon_yaml)
PYEOF
then
    bashio::log.error "Failed to fetch HA core config — cannot start AppDaemon."
    exit 1
fi

bashio::log.info "Starting AppDaemon..."
cd "${CONFIG_DIR}" || exit 1
exec appdaemon -c "${CONFIG_DIR}"
